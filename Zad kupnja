#include <iostream>
#include <iomanip>

using namespace std;

const double CIJENA_ULAZNICE = 5.0;
const int PRAG_POPUSTA = 5;
const double STOPA_POPUSTA = 0.10;

int ukupnoUlaznica = 0;
double ukupniPrihod = 0.0;

bool ispravanUnos(int kolicina);
double izracunajIznos(int kolicina);
void evidentirajKupnju(int kolicina, double iznos);
void ispisiKupnju(int redniBroj, double iznos);
void ispisiSazetak();

int main() {
    cout << fixed << setprecision(2);

    for (int i = 1; i <= 3; i++) {
        int unesenaKolicina;
        double izracunatiIznos;

        do {
            cout << "Kupnja " << i << " - unesi broj ulaznica (1-30): ";
            cin >> unesenaKolicina;
        } while (!ispravanUnos(unesenaKolicina));

        izracunatiIznos = izracunajIznos(unesenaKolicina);
        evidentirajKupnju(unesenaKolicina, izracunatiIznos);
        ispisiKupnju(i, izracunatiIznos);
    }

    ispisiSazetak();
    return 0;
}

bool ispravanUnos(int kolicina) {
    return kolicina >= 1 && kolicina <= 30;
}

double izracunajIznos(int kolicina) {
    double osnovniIznos = kolicina * CIJENA_ULAZNICE;
    double konacniIznos = (kolicina >= PRAG_POPUSTA) ? osnovniIznos * (1.0 - STOPA_POPUSTA) : osnovniIznos;
    return konacniIznos;
}

void evidentirajKupnju(int kolicina, double iznos) {
    ukupnoUlaznica += kolicina;
    ukupniPrihod += iznos;
}

void ispisiKupnju(int redniBroj, double iznos) {
    cout << "Kupnja " << redniBroj << ": " << iznos << " EUR\n";
}

void ispisiSazetak() {
    cout << "Ukupno prodanih ulaznica: " << ukupnoUlaznica << "\nUkupni prihod: " << ukupniPrihod << " EUR\n";
}
